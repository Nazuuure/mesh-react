{
    "compilerOptions": {
        "target": "ES2024",
        "lib": [
            "ES2024",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": [
            "vite/client",
            "node"
        ],
        "skipLibCheck": true
    },
    "include": [
        "src",
        "vite.config.ts"
    ]
}
